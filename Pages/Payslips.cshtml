@page
@model PayslipsModel
@{
    Layout = null;
    ViewData["Title"] = "Laufey | Issue Payment Slips";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Laufey | Issue Payment Slips</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

<header class="mobile-topbar">
    <div class="mobile-brand">
        <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
        <span class="brand-name">Laufey</span>
    </div>
    <div class="mobile-topbar-actions">
        <a href="/Logout" class="btn-mobile-signout" title="Sign out">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Logout</span>
        </a>
        <button type="button" class="btn-mobile-menu" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
    </div>
</header>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

<div class="app-shell">
    <aside class="app-sidebar" id="sidebar">
        <div>
            <div class="sidebar-brand">
                <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
                <span class="brand-name">Laufey</span>
            </div>

            <div class="sidebar-group-title">Main Menu</div>
            <nav class="sidebar-nav">
                <a href="/Index" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                        <span>Dashboard</span>
                    </div>
                </a>
                <a href="/Sales" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span>Sales & POS</span>
                    </div>
                </a>
                <a href="/Stocks" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        <span>Stock Management</span>
                    </div>
                </a>
                <a href="/StaffPerformance" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                        <span>Employee Performance</span>
                    </div>
                </a>
                <a href="/Approvals" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Requests & Approvals</span>
                    </div>
                </a>
                <a href="/Payslips" class="nav-link active">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9.5h20"/></svg>
                        <span>Send Payment Slips</span>
                    </div>
                    <span class="nav-badge-pill" style="background:#E6F4EA;color:#137333;">@Model.IssuedPayslips.Count</span>
                </a>
                <a href="/StaffAccounts" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        <span>Staff Accounts</span>
                    </div>
                </a>
            </nav>
        </div>

        <div class="sidebar-profile-card">
            <div class="profile-info">
                <div class="profile-avatar"><img src="~/images/Laufey.jpg" alt="Profile" asp-append-version="true" /></div>
                <div><div class="profile-name">Store Owner</div><div class="profile-role">Laufey Admin</div></div>
            </div>
            <a href="/Logout" class="btn-signout" title="Sign out">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <main class="app-workspace">
        <header class="workspace-topbar">
            <div class="welcome-col">
                <h1>Payment Slips (Payslip Issuance)</h1>
                <p>Generate, calculate, and disburse official wage payout slips directly to employee dashboards</p>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <button type="button" class="btn-action-primary" onclick="openPayslipModal('issueModal')">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span>+ Issue New Payslip</span>
                </button>
                <a href="/Logout" class="btn-topbar-signout" title="Sign out">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Logout</span>
                </a>
            </div>
        </header>

        <div class="workspace-scroll">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="toast-alert toast-success"><span>✓ @Model.SuccessMessage</span></div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="toast-alert" style="background:#FCE8E6;color:#C5221F;"><span>⚠️ @Model.ErrorMessage</span></div>
            }

            <div class="content-block">
                <div class="block-header" style="flex-wrap:wrap; gap:12px;">
                    <div>
                        <div class="block-title">Released Payment Slips History (@Model.FilterYear)</div>
                        <div class="block-subtitle">Click any payment slip to view and print the official salary receipt voucher</div>
                    </div>

                    <!-- Storage & Timeframe Filter Bar -->
                    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                        <div style="display:flex; background:#F0F5F1; padding:3px; border-radius:999px; border:1px solid var(--border-subtle);">
                            <a href="?ViewMode=active&FilterYear=@Model.FilterYear&Range=@Model.Range" class="btn-filter-pill @(Model.ViewMode == "active" ? "active-range" : "")" style="text-decoration:none;">Active</a>
                            <a href="?ViewMode=archived&FilterYear=@Model.FilterYear&Range=@Model.Range" class="btn-filter-pill @(Model.ViewMode == "archived" ? "active-range" : "")" style="text-decoration:none;">Archived (@Model.ArchivedCount)</a>
                        </div>
                        <div style="display:flex; background:#F0F5F1; padding:3px; border-radius:999px; border:1px solid var(--border-subtle);">
                            <a href="?ViewMode=@Model.ViewMode&FilterYear=@Model.FilterYear&Range=daily" class="btn-filter-pill @(Model.Range == "daily" ? "active-range" : "")" style="text-decoration:none;">Daily</a>
                            <a href="?ViewMode=@Model.ViewMode&FilterYear=@Model.FilterYear&Range=weekly" class="btn-filter-pill @(Model.Range == "weekly" ? "active-range" : "")" style="text-decoration:none;">Weekly</a>
                            <a href="?ViewMode=@Model.ViewMode&FilterYear=@Model.FilterYear&Range=monthly" class="btn-filter-pill @(Model.Range == "monthly" ? "active-range" : "")" style="text-decoration:none;">Monthly</a>
                            <a href="?ViewMode=@Model.ViewMode&FilterYear=@Model.FilterYear&Range=yearly" class="btn-filter-pill @(Model.Range == "yearly" ? "active-range" : "")" style="text-decoration:none;">All @Model.FilterYear</a>
                        </div>
                        <select onchange="window.location.href='?ViewMode=@Model.ViewMode&Range=@Model.Range&FilterYear='+this.value" style="padding:5px 10px; border-radius:999px; border:1px solid #CFDDD4; font-size:12px; font-weight:600; background:#FFF; color:var(--forest-dark);">
                            <option value="2026" selected="@(Model.FilterYear == 2026)">2026</option>
                            <option value="2025" selected="@(Model.FilterYear == 2025)">2025</option>
                        </select>
                    </div>
                </div>

                <div style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
                    <table class="clean-table compact-staff-table">
                        <thead>
                            <tr>
                                <th>Staff Member</th>
                                <th>Pay Period</th>
                                <th>Hours</th>
                                <th>Gross Pay</th>
                                <th>Vale Deductions</th>
                                <th>Net Pay Out</th>
                                <th>Channel</th>
                                <th>Issued Date</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.IssuedPayslips.Any())
                            {
                                @foreach (var p in Model.IssuedPayslips)
                                {
                                    var wName = Model.WorkerNames.TryGetValue(p.WorkerId, out var n) ? n : $"Worker #{p.WorkerId}";
                                    <tr style="cursor:pointer;" onclick="openReceiptModal('@p.Id', '@Html.Raw(wName.Replace("'", "\\'"))', 'EMP-@p.WorkerId.ToString("D3")', '@Html.Raw(p.PayPeriod.Replace("'", "\\'"))', '@p.HoursWorked.ToString("0.00")', '@p.HourlyRate.ToString("N2")', '@p.GrossPay.ToString("N2")', '@p.CashAdvanceDeductions.ToString("N2")', '@p.OtherDeductions.ToString("N2")', '@p.NetPay.ToString("N2")', '@p.PaymentMethod', '@p.IssuedAtUtc.AddHours(8).ToString("MMM dd, yyyy")', '@(p.IsAcknowledged ? "Acknowledged" : "Pending Receipt")', '@Html.Raw((p.Remarks ?? "Standard payroll payout").Replace("'", "\\'"))')">
                                        <td><strong>@wName</strong></td>
                                        <td>@p.PayPeriod</td>
                                        <td>@p.HoursWorked.ToString("0.00") hrs</td>
                                        <td>₱@p.GrossPay.ToString("N2")</td>
                                        <td style="color:#C5221F;">-₱@p.CashAdvanceDeductions.ToString("N2")</td>
                                        <td><strong style="color:#137333; font-size:14px;">₱@p.NetPay.ToString("N2")</strong></td>
                                        <td><span class="badge-status" style="background:#F0F5F1; color:var(--forest-dark);">@p.PaymentMethod</span></td>
                                        <td>@p.IssuedAtUtc.AddHours(8).ToString("MMM dd, yyyy")</td>
                                        <td style="text-align:right; white-space:nowrap;" onclick="event.stopPropagation();">
                                            <button type="button" class="btn-pill-action" onclick="openReceiptModal('@p.Id', '@Html.Raw(wName.Replace("'", "\\'"))', 'EMP-@p.WorkerId.ToString("D3")', '@Html.Raw(p.PayPeriod.Replace("'", "\\'"))', '@p.HoursWorked.ToString("0.00")', '@p.HourlyRate.ToString("N2")', '@p.GrossPay.ToString("N2")', '@p.CashAdvanceDeductions.ToString("N2")', '@p.OtherDeductions.ToString("N2")', '@p.NetPay.ToString("N2")', '@p.PaymentMethod', '@p.IssuedAtUtc.AddHours(8).ToString("MMM dd, yyyy")', '@(p.IsAcknowledged ? "Acknowledged" : "Pending Receipt")', '@Html.Raw((p.Remarks ?? "Standard payroll payout").Replace("'", "\\'"))')">Receipt</button>
                                            <form method="post" asp-page-handler="ToggleArchive" style="display:inline; margin-left:4px;">
                                                <input type="hidden" name="payslipId" value="@p.Id" />
                                                <input type="hidden" name="viewMode" value="@Model.ViewMode" />
                                                <input type="hidden" name="filterYear" value="@Model.FilterYear" />
                                                <input type="hidden" name="range" value="@Model.Range" />
                                                <button type="submit" class="btn-pill-action" style="background:#F3F4F6; color:#4B5563;">
                                                    @(p.IsArchived ? "Restore" : "Archive")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="9" style="text-align:center; padding:24px; color:var(--text-muted);">No @Model.ViewMode payment slips found for @Model.FilterYear (@Model.Range).</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- MODAL: ISSUE NEW PAYSLIP -->
<div class="modal-overlay" id="issueModal">
    <div class="modal-box">
        <form method="post" asp-page-handler="IssuePayslip">
            <div class="modal-head">
                <h3>Generate & Issue Payment Slip</h3>
                <button type="button" class="modal-close-btn" onclick="closePayslipModal('issueModal')">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Select Staff Member</label>
                    <select name="workerId" id="psWorker" onchange="autoFillWorkerRate()" style="width:100%; padding:9px 10px; border-radius:8px; border:1px solid #CFDDD4; font-size:13px; outline:none; background:#FFF;">
                        @foreach (var w in Model.ActiveWorkers)
                        {
                            var hWorked = Model.WorkerHoursWorkedMonth.TryGetValue(w.Id, out var hw) ? hw : 0m;
                            var vAdv = Model.WorkerPendingAdvances.TryGetValue(w.Id, out var va) ? va : 0m;
                            <option value="@w.Id" data-rate="@w.HourlyRate" data-hours="@hWorked" data-vale="@vAdv">
                                @w.FullName (₱@w.HourlyRate.ToString("N2")/hr &bull; @hWorked.ToString("0.00") hrs logged &bull; ₱@vAdv.ToString("N0") vale)
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Pay Period</label>
                    <input type="text" name="payPeriod" value="Cutoff: @DateTime.UtcNow.AddHours(8).ToString("MMMM 01-15, yyyy")" required />
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Hours Worked</label>
                        <input type="number" step="0.25" id="psHours" name="hoursWorked" value="40" min="0" oninput="calcNet()" required />
                    </div>
                    <div class="form-group">
                        <label>Hourly Rate (₱)</label>
                        <input type="number" step="0.01" id="psRate" name="hourlyRate" value="150.00" oninput="calcNet()" required />
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Cash Advance (Vale) Deductions (₱)</label>
                        <input type="number" step="0.01" id="psVale" name="advanceDeductions" value="0.00" min="0" oninput="calcNet()" />
                    </div>
                    <div class="form-group">
                        <label>Other Deductions (₱)</label>
                        <input type="number" step="0.01" id="psOther" name="otherDeductions" value="0.00" min="0" oninput="calcNet()" />
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Estimated Net Pay (₱)</label>
                        <input type="text" id="psNetDisplay" readonly style="background:#F0F6F2; font-size:16px; font-weight:800; color:#1E663B;" value="₱6,000.00" />
                    </div>
                    <div class="form-group">
                        <label>Disbursement Channel</label>
                        <select name="paymentMethod">
                            <option value="Cash">Cash Envelope</option>
                            <option value="GCash">GCash Transfer</option>
                            <option value="Maya">Maya Transfer</option>
                            <option value="Bank">Bank Deposit</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Remarks / Note (Optional)</label>
                    <input type="text" name="remarks" placeholder="e.g. Regular 1st cutoff wage" />
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn-secondary" onclick="closePayslipModal('issueModal')">Cancel</button>
                <button type="submit" class="btn-primary">Disburse & Send to Employee</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openPayslipModal(id) { document.getElementById(id).classList.add('open'); autoFillWorkerRate(); }
    function closePayslipModal(id) { document.getElementById(id).classList.remove('open'); }

    function autoFillWorkerRate() {
        const select = document.getElementById('psWorker');
        if (!select) return;
        const selected = select.options[select.selectedIndex];
        const rate = parseFloat(selected.getAttribute('data-rate')) || 150;
        const hours = parseFloat(selected.getAttribute('data-hours')) || 40;
        const vale = parseFloat(selected.getAttribute('data-vale')) || 0;

        document.getElementById('psRate').value = rate.toFixed(2);
        document.getElementById('psHours').value = hours.toFixed(2);
        document.getElementById('psVale').value = vale.toFixed(2);
        calcNet();
    }

    function calcNet() {
        const hours = parseFloat(document.getElementById('psHours').value) || 0;
        const rate = parseFloat(document.getElementById('psRate').value) || 0;
        const vale = parseFloat(document.getElementById('psVale').value) || 0;
        const other = parseFloat(document.getElementById('psOther').value) || 0;
        const gross = hours * rate;
        const net = Math.max(0, gross - vale - other);
        document.getElementById('psNetDisplay').value = '₱' + net.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function toggleMobileSidebar() {
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('sidebarBackdrop');
        if (sb) sb.classList.toggle('sidebar-open');
        if (bd) bd.classList.toggle('active');
    }

    function openReceiptModal(id, workerName, empId, payPeriod, hours, rate, gross, vale, other, net, method, issuedDate, ackStatus, remarks) {
        document.getElementById('rcptVoucherNo').textContent = '#LP-' + new Date().getFullYear() + '-' + String(id).padStart(4, '0');
        document.getElementById('rcptIssuedDate').textContent = issuedDate;
        document.getElementById('rcptWorkerName').textContent = workerName;
        document.getElementById('rcptEmpId').textContent = empId;
        document.getElementById('rcptPayPeriod').textContent = payPeriod;
        document.getElementById('rcptHoursWorked').textContent = hours + ' hrs';
        document.getElementById('rcptHourlyRate').textContent = '₱' + rate + ' / hr';
        document.getElementById('rcptGrossPay').textContent = '₱' + gross;
        document.getElementById('rcptValeDeductions').textContent = '-₱' + vale;
        document.getElementById('rcptOtherDeductions').textContent = '-₱' + other;
        document.getElementById('rcptNetPay').textContent = '₱' + net;
        document.getElementById('rcptPaymentMethod').textContent = method;
        document.getElementById('rcptAckStatus').textContent = ackStatus;
        document.getElementById('rcptRemarks').textContent = remarks;
        document.getElementById('receiptModal').style.display = 'flex';
    }
    function closeReceiptModal() {
        document.getElementById('receiptModal').style.display = 'none';
    }
    function printReceiptVoucher() {
        window.print();
    }
</script>

<!-- OFFICIAL SALARY RECEIPT / VOUCHER MODAL -->
<div id="receiptModal" class="modal-backdrop" style="display:none; position:fixed; inset:0; background:rgba(18,34,26,0.65); backdrop-filter:blur(4px); z-index:99999; align-items:center; justify-content:center; padding:16px;">
    <div class="receipt-card" style="background:#FFF; max-width:520px; width:100%; border-radius:18px; overflow:hidden; box-shadow:0 24px 48px rgba(0,0,0,0.25); border:1px solid #E0EBE3;">
        <div style="background:linear-gradient(135deg, #182C22 0%, #294F3B 100%); color:#FFF; padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:36px; height:36px; border-radius:50%; overflow:hidden; border:2px solid #5EEA99; background:#FFF;">
                    <img src="/images/Laufey.jpg" alt="Laufey" style="width:100%; height:100%; object-fit:cover;" />
                </div>
                <div>
                    <h3 style="margin:0; font-size:16px; font-weight:700;">Laufey Store</h3>
                    <div style="font-size:11px; color:#A9CCBA; text-transform:uppercase; letter-spacing:0.8px;">Official Compensation Voucher</div>
                </div>
            </div>
            <button type="button" onclick="closeReceiptModal()" style="background:none; border:none; color:#FFF; font-size:20px; cursor:pointer;">✕</button>
        </div>
        <div id="receiptPrintArea" style="padding:22px 24px; font-size:13px; color:#142019;">
            <div style="display:flex; justify-content:space-between; padding-bottom:12px; border-bottom:1px dashed #D5E2D9; margin-bottom:14px;">
                <div>
                    <span style="font-size:11px; color:#6B8074;">VOUCHER NO.</span>
                    <div id="rcptVoucherNo" style="font-weight:700; font-size:14px; font-family:monospace;">#LP-2026-0001</div>
                </div>
                <div style="text-align:right;">
                    <span style="font-size:11px; color:#6B8074;">ISSUED ON</span>
                    <div id="rcptIssuedDate" style="font-weight:600;">Nov 25, 2026</div>
                </div>
            </div>
            <div style="background:#F6FAF7; border:1px solid #DCE8E0; border-radius:10px; padding:12px 14px; margin-bottom:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span style="color:#63756A;">Personnel:</span><strong id="rcptWorkerName"></strong></div>
                <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span style="color:#63756A;">Staff ID:</span><strong id="rcptEmpId" style="font-family:monospace;"></strong></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#63756A;">Pay Period:</span><strong id="rcptPayPeriod" style="color:#234633;"></strong></div>
            </div>
            <div style="margin-bottom:14px;">
                <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:#4B6354; margin-bottom:6px;">Earnings Breakdown</div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0;"><span>Hours Rendered</span><span id="rcptHoursWorked" style="font-weight:600;"></span></div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0;"><span>Hourly Rate</span><span id="rcptHourlyRate" style="font-weight:600;"></span></div>
                <div style="display:flex; justify-content:space-between; padding:7px 0; font-weight:700; border-bottom:1.5px solid #D5E2D9;"><span>Gross Earnings</span><span id="rcptGrossPay" style="color:#1E663B;"></span></div>
            </div>
            <div style="margin-bottom:16px;">
                <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:#853B3B; margin-bottom:6px;">Deductions</div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0; color:#A82222;"><span>Cash Advance / Vale</span><span id="rcptValeDeductions"></span></div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0; color:#A82222;"><span>Other Deductions</span><span id="rcptOtherDeductions"></span></div>
            </div>
            <div style="background:linear-gradient(135deg, #182C22 0%, #224231 100%); color:#FFF; border-radius:10px; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div>
                    <div style="font-size:10.5px; text-transform:uppercase; color:#A9CCBA;">Total Net Payout</div>
                    <div style="font-size:12px;">Via <strong id="rcptPaymentMethod"></strong></div>
                </div>
                <div id="rcptNetPay" style="font-size:24px; font-weight:800; color:#5EEA99;"></div>
            </div>
            <div style="font-size:11.5px; color:#6B8074; margin-bottom:10px;">Remarks: <span id="rcptRemarks"></span></div>
            <div style="display:flex; justify-content:space-between; padding-top:10px; font-size:11.5px; color:#6B8074; border-top:1px dashed #D5E2D9;">
                <div>Issued by: <strong>Laufey Management</strong></div>
                <div>Status: <strong id="rcptAckStatus" style="color:#137333;"></strong></div>
            </div>
        </div>
        <div style="background:#F7FAF8; border-top:1px solid #E3ECE6; padding:12px 24px; display:flex; justify-content:space-between;">
            <button type="button" onclick="closeReceiptModal()" style="background:#FFF; border:1px solid #CFDDD4; border-radius:8px; padding:8px 16px; font-size:12.5px; font-weight:600; cursor:pointer;">Close</button>
            <button type="button" onclick="printReceiptVoucher()" style="background:#234633; border:none; border-radius:8px; padding:8px 18px; font-size:12.5px; font-weight:600; color:#FFF; cursor:pointer;">Print / Save PDF</button>
        </div>
    </div>
</div>
</body>
</html>
