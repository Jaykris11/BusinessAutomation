@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Laufey | Business Dashboard";
    var currentRange = Model.Range?.ToLower() ?? "daily";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Laufey | Business Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="dashboard-body">

<header class="mobile-topbar">
    <div class="mobile-brand">
        <div class="brand-circle">
            <img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" />
        </div>
        <span class="brand-name">Laufey</span>
    </div>
    <button type="button" class="btn-mobile-menu" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
</header>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

<div class="app-shell">

    <!-- 1. SLIM SIDEBAR -->
    <aside class="app-sidebar" id="sidebar">
        <div>
            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="brand-circle">
                    <img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" />
                </div>
                <span class="brand-name">Laufey</span>
            </div>

            <!-- Navigation Links -->
            <div class="sidebar-group-title">Main Menu</div>
            <nav class="sidebar-nav">
                <a href="/Index" class="nav-link active">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                        <span>Dashboard</span>
                    </div>
                </a>
                <a href="/Sales" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span>Sales & POS</span>
                    </div>
                </a>
                <a href="/Stocks" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        <span>Stock Management</span>
                    </div>
                    @if (Model.LowStockAlertCount > 0)
                    {
                        <span class="nav-badge-pill" style="background:#FCE8E6;color:#C5221F;">@Model.LowStockAlertCount</span>
                    }
                </a>
                <a href="/StaffPerformance" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                        <span>Employee Performance</span>
                    </div>
                </a>
                <a href="/Approvals" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Requests & Approvals</span>
                    </div>
                    @if (Model.PendingLeaveRequests.Count + Model.PendingAdvanceRequests.Count > 0)
                    {
                        <span class="nav-badge-pill" style="background:#FEF7E0;color:#B06000;">@(Model.PendingLeaveRequests.Count + Model.PendingAdvanceRequests.Count)</span>
                    }
                </a>
                <a href="/Payslips" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9.5h20"/></svg>
                        <span>Send Payment Slips</span>
                    </div>
                </a>
            </nav>

            <div class="sidebar-group-title">Preferences</div>
            <nav class="sidebar-nav">
                <a href="#" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        <span>Store Settings</span>
                    </div>
                </a>
            </nav>
        </div>

        <!-- Bottom User / Logout Card -->
        <div class="sidebar-profile-card">
            <div class="profile-info">
                <div class="profile-avatar">
                    <img src="~/images/Laufey.jpg" alt="Profile" asp-append-version="true" />
                </div>
                <div>
                    <div class="profile-name">@(string.IsNullOrEmpty(Model.DisplayName) ? "Owner" : Model.DisplayName)</div>
                    <div class="profile-role">Store Owner</div>
                </div>
            </div>
            <form method="post" asp-page-handler="Logout" style="display:inline; margin:0;">
                <button type="submit" class="btn-signout" title="Sign out">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </button>
            </form>
        </div>
    </aside>

    <!-- 2. MAIN WORKSPACE AREA -->
    <main class="app-workspace">

        <!-- Top Header Navigation with TIMEFRAME FILTERS (Daily / Weekly / Monthly / Yearly) -->
        <header class="workspace-topbar">
            <button class="mobile-menu-btn" id="toggleMobileMenu" aria-label="Open menu">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>

            <div class="welcome-col">
                <h1>Hello, @(string.IsNullOrEmpty(Model.DisplayName) ? "Owner" : Model.DisplayName) 👋</h1>
                <p>Welcome to your business analytics &bull; <strong>@Model.CurrentStoreShift</strong></p>
            </div>

            <!-- TIMEFRAME SELECTOR BUTTONS (Daily / Weekly / Monthly / Yearly) -->
            <div style="display:flex; align-items:center; gap:6px; background:#F0F5F1; padding:3px 6px; border-radius:var(--radius-pill); border:1px solid var(--border-subtle);">
                <a href="?range=daily" class="btn-filter-pill @(currentRange == "daily" ? "active-range" : "")" style="text-decoration:none;">Daily</a>
                <a href="?range=weekly" class="btn-filter-pill @(currentRange == "weekly" ? "active-range" : "")" style="text-decoration:none;">Weekly</a>
                <a href="?range=monthly" class="btn-filter-pill @(currentRange == "monthly" ? "active-range" : "")" style="text-decoration:none;">Monthly</a>
                <a href="?range=yearly" class="btn-filter-pill @(currentRange == "yearly" ? "active-range" : "")" style="text-decoration:none;">Yearly</a>
            </div>

            <div class="topbar-right">
                <div class="clean-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" id="searchInput" placeholder="Search staff name or ID..." onkeyup="filterStaffTable()" />
                </div>
            </div>
        </header>

        <!-- Main Workspace Body -->
        <div class="workspace-scroll">

            <!-- Flash Notifications -->
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="toast-alert toast-success">
                    <span>✓ @Model.SuccessMessage</span>
                    <button type="button" onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:inherit;">✕</button>
                </div>
            }

            <!-- SECTION 1: 4 COMPACT METRICS (Clocked In, Absent, Stocks, Shift) -->
            <div class="compact-kpi-row">
                
                <!-- 1. Clocked In Today -->
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top">
                        <span class="kpi-mini-title">Clocked In</span>
                        <div class="kpi-mini-icon" style="background:#E6F4EA;color:#137333;">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                    </div>
                    <div>
                        <div class="kpi-mini-val" id="liveClockedInVal">@Model.ClockedInCount <span style="font-size:14px;font-weight:400;color:var(--text-muted);">/ @Model.TotalWorkers</span></div>
                        <div class="kpi-mini-sub" style="color:#137333;">✓ Active on duty</div>
                    </div>
                </div>

                <!-- 2. Absent Today -->
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top">
                        <span class="kpi-mini-title">Absent Today</span>
                        <div class="kpi-mini-icon" style="background:#FCE8E6;color:#C5221F;">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        </div>
                    </div>
                    <div>
                        <div class="kpi-mini-val" style="color:#C5221F;">@Model.AbsentCount</div>
                        <div class="kpi-mini-sub" style="color:#C5221F;">No time-in logged</div>
                    </div>
                </div>

                <!-- 3. Overall Stocks & Alerts -->
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top">
                        <span class="kpi-mini-title">Overall Stocks</span>
                        <div class="kpi-mini-icon" style="background:#FEF7E0;color:#B06000;">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        </div>
                    </div>
                    <div>
                        <div class="kpi-mini-val">@Model.OverallStockCount <span style="font-size:13px;font-weight:400;color:var(--text-muted);">units</span></div>
                        @if (Model.LowStockAlertCount > 0)
                        {
                            <div class="kpi-mini-sub" style="color:#C5221F;">⚠️ @Model.LowStockAlertCount low stock items</div>
                        }
                        else
                        {
                            <div class="kpi-mini-sub" style="color:var(--sage-accent);">Stocks healthy</div>
                        }
                    </div>
                </div>

                <!-- 4. Current Store Shift & Owner Shift Control (Start / Stop) -->
                <div class="kpi-mini-card" style="background:linear-gradient(145deg, #182C22 0%, #294F3B 100%); color:#FFF;">
                    <div class="kpi-mini-top">
                        <span class="kpi-mini-title" style="color:#A9CCBA;">Store Shift</span>
                        <div class="pulse-badge" style="padding:2px 8px;font-size:10px; background:@(Model.IsShiftActive ? "rgba(74,222,128,0.2)" : "rgba(239,68,68,0.2)"); color:@(Model.IsShiftActive ? "#4ADE80" : "#F87171");">
                            <i class="pulse-dot" style="background:@(Model.IsShiftActive ? "#4ADE80" : "#F87171");"></i> @(Model.IsShiftActive ? "Active" : "Closed")
                        </div>
                    </div>
                    <div>
                        <div class="kpi-mini-val" id="liveShiftTimer" style="color:#FFF; font-size:20px;">00:00:00</div>
                        <div class="kpi-mini-sub" style="color:rgba(255,255,255,0.85); font-size:11.5px; margin-bottom:8px;">@Model.CurrentStoreShift</div>
                        
                        <form method="post" asp-page-handler="ToggleStoreShift" style="margin:0;">
                            @if (Model.IsShiftActive)
                            {
                                <button type="submit" style="padding:4px 10px; border-radius:6px; border:none; background:#EF4444; color:#FFF; font-size:11px; font-weight:700; cursor:pointer;">
                                    ■ End Shift
                                </button>
                            }
                            else
                            {
                                <button type="submit" style="padding:4px 10px; border-radius:6px; border:none; background:#10B981; color:#FFF; font-size:11px; font-weight:700; cursor:pointer;">
                                    ▶ Start Store Shift
                                </button>
                            }
                        </form>
                    </div>
                </div>

            </div>

            <!-- MAIN GRID: CENTER STAGE (Left 2/3) + RIGHT SIDEBAR (Right 1/3) -->
            <div class="dashboard-grid-container">

                <!-- LEFT STAGE -->
                <div style="display:flex; flex-direction:column; gap:24px;">

                    <!-- SECTION 2: LIFECARE CURVED WAVE CHART (Sales, Capital & Profit with Floating Tooltip) -->
                    <div class="wave-chart-card">
                        <div class="block-header" style="margin-bottom:12px;">
                            <div>
                                <div class="block-title">Financial Performance: Sales, Capital & Profit</div>
                                <div class="block-subtitle">Tracking net earnings against inventory capital and labor costs</div>
                            </div>
                            <div style="display:flex; align-items:center; gap:16px;">
                                <span style="font-size:12.5px; color:var(--text-secondary);">
                                    Sales: <strong style="color:var(--forest-dark);">₱@Model.PeriodSales.ToString("N2")</strong>
                                </span>
                                <span style="font-size:12.5px; color:var(--text-secondary);">
                                    Capital: <strong style="color:#6A7D73;">₱@Model.PeriodCapital.ToString("N2")</strong>
                                </span>
                                <span class="badge-status" style="background:#E6F4EA;color:#137333;font-size:12.5px; font-weight:700;">
                                    Net Profit: ₱@Model.PeriodProfit.ToString("N2")
                                </span>
                            </div>
                        </div>

                        <!-- Interactive Responsive Chart.js Financial Graph -->
                        <div style="position:relative; height:220px; width:100%; margin-top:8px;">
                            <canvas id="ownerFinanceChart"></canvas>
                        </div>
                    </div>

                    <!-- SECTION 3: STAFF HOURS WORKED (Compact & Neat Table) -->
                    <div class="content-block" id="staffHoursSection">
                        <div class="block-header" style="margin-bottom:14px;">
                            <div>
                                <div class="block-title">Staff Hours Worked & Accumulated Wages (@currentRange.ToUpper())</div>
                                <div class="block-subtitle">Daily hours clocked in and gross earnings computed from verified punches</div>
                            </div>
                            <button class="btn-action-primary" onclick="openAddWorkerModal()" style="padding:5px 14px; font-size:12px;">
                                <span>+ Add Staff</span>
                            </button>
                        </div>

                        <div style="overflow-x:auto;">
                            <table class="clean-table compact-staff-table" id="staffTable">
                                <thead>
                                    <tr>
                                        <th>Staff Member</th>
                                        <th>Pay Rate</th>
                                        <th>Hours Put In</th>
                                        <th>Money Earned</th>
                                        <th>Latest Punch</th>
                                        <th>Status</th>
                                        <th style="text-align:right;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.WorkerAttendanceList.Any())
                                    {
                                        @foreach (var w in Model.WorkerAttendanceList)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="table-user-cell" style="gap:8px;">
                                                        <div class="table-user-avatar" style="width:28px;height:28px;">
                                                            <img src="~/images/Laufey.jpg" alt="" asp-append-version="true" />
                                                        </div>
                                                        <div>
                                                            <div class="table-user-name" style="font-size:12.5px;">@w.FullName</div>
                                                            <div class="table-user-id" style="font-size:10.5px;">@w.EmployeeId</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>₱@w.Rate.ToString("N2") @(w.PayType == PayrollApp.Web.Data.PayType.Hourly ? "/hr" : "/day")</td>
                                                <td>
                                                    <strong style="color:var(--forest-dark);">@w.HoursWorked.ToString("0.00")</strong> hrs
                                                </td>
                                                <td>
                                                    <strong style="color:#1E663B;">₱@w.EarnedAmount.ToString("N2")</strong>
                                                </td>
                                                <td>
                                                    <span style="font-size:11px; background:#F0F5F1; padding:2px 6px; border-radius:4px;">@w.LatestPunch</span>
                                                </td>
                                                <td>
                                                    @if (w.IsClockedIn)
                                                    {
                                                        <span class="badge-status badge-present" style="font-size:10.5px; padding:2px 8px;">✓ Clocked In</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-status" style="background:#FCE8E6;color:#C5221F;font-size:10.5px; padding:2px 8px;">✕ Absent</span>
                                                    }
                                                </td>
                                                <td style="text-align:right;">
                                                    <button type="button" class="table-action-btn" style="padding:2px 8px; font-size:11px;"
                                                            onclick="openEditWorkerModal(@w.WorkerId, '@w.FullName', @((int)w.PayType), @w.Rate, 8)">
                                                        Edit
                                                    </button>
                                                    <form method="post" asp-page-handler="DeactivateWorker" style="display:inline; margin-left:4px;" onsubmit="return confirm('Deactivate @w.FullName?');">
                                                        <input type="hidden" name="workerId" value="@w.WorkerId" />
                                                        <button type="submit" class="table-action-btn" style="color:#C0392B; padding:2px 8px; font-size:11px;">✕</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- SECTION 4: QUICK INVENTORY OVERVIEW -->
                    <div class="content-block" id="stocksSection">
                        <div class="block-header">
                            <div>
                                <div class="block-title">Store Inventory & Stock Levels</div>
                                <div class="block-subtitle">Ingredients, beans and supplies on shelf</div>
                            </div>
                            <a href="/Stocks" class="btn-action-primary" style="padding:5px 14px; font-size:12px; text-decoration:none;">
                                <span>Go to Stock Management →</span>
                            </a>
                        </div>

                        <div style="overflow-x:auto;">
                            <table class="clean-table compact-staff-table">
                                <thead>
                                    <tr>
                                        <th>Item Name</th>
                                        <th>Category</th>
                                        <th>Cost Price</th>
                                        <th>Selling Price</th>
                                        <th>Current Stock</th>
                                        <th>Status</th>
                                        <th style="text-align:right;">Restock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.AllProducts.Take(6))
                                    {
                                        <tr>
                                            <td><strong>@p.Name</strong></td>
                                            <td>@p.Category</td>
                                            <td style="color:#6A7D73;">₱@p.Cost.ToString("N2")</td>
                                            <td><strong style="color:var(--forest-dark);">₱@p.Price.ToString("N2")</strong></td>
                                            <td>@p.CurrentStock units</td>
                                            <td>
                                                @if (p.IsLowStock)
                                                {
                                                    <span class="badge-status" style="background:#FCE8E6;color:#C5221F;">Low Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-status badge-present">In Stock</span>
                                                }
                                            </td>
                                            <td style="text-align:right;">
                                                <a href="/Stocks" class="btn-pill-action" style="text-decoration:none;">Manage</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- SECTION 5: QUICK LINK TO APPROVALS -->
                    <div class="content-block" id="approvalsSection">
                        <div class="block-header">
                            <div>
                                <div class="block-title">Employee Requests & Approvals</div>
                                <div class="block-subtitle">Review PTO, VTO leaves and Cash Advance (Vale) applications</div>
                            </div>
                            <a href="/Approvals" class="btn-action-primary" style="padding:5px 14px; font-size:12px; text-decoration:none;">
                                <span>Open Requests Portal →</span>
                            </a>
                        </div>

                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                            <div style="background:#F9FBF9; border:1px solid #E1EBE4; border-radius:12px; padding:14px; display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <strong style="font-size:13px; color:var(--forest-dark);">Leave & PTO Requests</strong>
                                    <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">Staff requesting time off</div>
                                </div>
                                <span class="badge-status" style="background:#FEF7E0;color:#B06000;font-size:12px;font-weight:700;">@Model.PendingLeaveRequests.Count Pending</span>
                            </div>
                            <div style="background:#F9FBF9; border:1px solid #E1EBE4; border-radius:12px; padding:14px; display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <strong style="font-size:13px; color:var(--forest-dark);">Cash Advance (Vale) Requests</strong>
                                    <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">Staff requesting salary advances</div>
                                </div>
                                <span class="badge-status" style="background:#FEF7E0;color:#B06000;font-size:12px;font-weight:700;">@Model.PendingAdvanceRequests.Count Pending</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- RIGHT SIDEBAR MENU (Maximizing all features) -->
                <div class="workspace-right-sidebar">

                    <!-- WIDGET 1: LIVE LABOR COST TICKER & RATIO -->
                    <div class="labor-burn-card">
                        <div class="right-card-header" style="margin-bottom:6px;">
                            <span class="right-card-title">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                Live Labor Burner
                            </span>
                            <div class="pulse-badge" style="padding:1px 6px; font-size:9.5px;"><i class="pulse-dot"></i> Live</div>
                        </div>
                        <div style="font-size:12px; color:var(--text-secondary);">Currently running wage cost:</div>
                        <div class="burn-stat-row">
                            <div class="burn-value" id="laborBurnDisplay">₱@Model.TotalLaborCostSoFar.ToString("N2")</div>
                            <span style="font-size:12px; color:var(--text-muted);">+₱@Model.LiveLaborCostRatePerHour.ToString("0.00")/hr</span>
                        </div>
                        <div style="margin-top:12px; padding-top:10px; border-top:1px solid rgba(35,70,51,0.12); display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:11.5px; color:var(--text-secondary);">Labor-to-Sales Ratio:</span>
                            <span class="badge-status" style="background:#E8F0EA;color:#183625;font-weight:700;font-size:11.5px;">
                                @Model.LaborCostRatioPct% @(Model.LaborCostRatioPct <= 30 ? "✓ Healthy" : "⚠️ High")
                            </span>
                        </div>
                    </div>

                    <!-- WIDGET 2: REORDER & LOW STOCK ALERTS -->
                    <div class="right-card">
                        <div class="right-card-header">
                            <span class="right-card-title">
                                <span>⚠️ Reorder Alerts</span>
                            </span>
                            <span class="badge-status" style="background:#FCE8E6;color:#C5221F;font-size:11px;">@Model.LowStockAlertCount Items</span>
                        </div>
                        <div>
                            @if (Model.LowStockProducts.Any())
                            {
                                @foreach (var p in Model.LowStockProducts)
                                {
                                    <div class="activity-item" style="padding:8px 0; display:flex; justify-content:space-between; align-items:center;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <div class="activity-dot" style="background:#FCE8E6;color:#C5221F;width:24px;height:24px;font-size:10px;">!</div>
                                            <div>
                                                <div style="font-size:12px; font-weight:600; color:var(--forest-dark);">@p.Name</div>
                                                <div style="font-size:10.5px; color:#C5221F;"><strong>@p.CurrentStock left</strong> (Limit: @p.LowStockAlert)</div>
                                            </div>
                                        </div>
                                        <a href="/Stocks" class="btn-pill-action" style="text-decoration:none;">
                                            Restock
                                        </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="font-size:12px; color:var(--text-muted); text-align:center; padding:12px 0;">All inventory levels are healthy.</div>
                            }
                        </div>
                    </div>

                    <!-- WIDGET 3: QUICK ACTIONS TO DEDICATED MODULES -->
                    <div class="right-card" style="background:#F7FAF8; border:1px solid #D6E3DA;">
                        <div class="right-card-header">
                            <span class="right-card-title">Quick Portals</span>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:8px;">
                            <a href="/Sales" style="padding:10px; background:#FFF; border:1px solid #CFDDD4; border-radius:8px; text-decoration:none; color:var(--forest-dark); font-size:12.5px; font-weight:600; display:flex; justify-content:space-between; align-items:center;">
                                <span>🛒 Sales & POS Page</span>
                                <span style="color:var(--text-muted);">→</span>
                            </a>
                            <a href="/Stocks" style="padding:10px; background:#FFF; border:1px solid #CFDDD4; border-radius:8px; text-decoration:none; color:var(--forest-dark); font-size:12.5px; font-weight:600; display:flex; justify-content:space-between; align-items:center;">
                                <span>📦 Stock Management Page</span>
                                <span style="color:var(--text-muted);">→</span>
                            </a>
                            <a href="/StaffPerformance" style="padding:10px; background:#FFF; border:1px solid #CFDDD4; border-radius:8px; text-decoration:none; color:var(--forest-dark); font-size:12.5px; font-weight:600; display:flex; justify-content:space-between; align-items:center;">
                                <span>🏆 Staff Leaderboard Page</span>
                                <span style="color:var(--text-muted);">→</span>
                            </a>
                            <a href="/Approvals" style="padding:10px; background:#FFF; border:1px solid #CFDDD4; border-radius:8px; text-decoration:none; color:var(--forest-dark); font-size:12.5px; font-weight:600; display:flex; justify-content:space-between; align-items:center;">
                                <span>📝 Requests & Approvals</span>
                                <span style="color:var(--text-muted);">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- WIDGET 4: STORE ANNOUNCEMENTS & MEMO BOARD -->
                    <div class="right-card">
                        <div class="right-card-header">
                            <span class="right-card-title">
                                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                Store Memo Board
                            </span>
                            <button type="button" class="btn-pill-action" onclick="openModal('announcementModal')">+ Post</button>
                        </div>
                        <div>
                            @if (Model.Announcements.Any())
                            {
                                @foreach (var a in Model.Announcements)
                                {
                                    <div class="memo-item">
                                        <div class="memo-title">
                                            @if (a.Priority == "Urgent")
                                            {
                                                <span style="color:#C5221F;">🔴</span>
                                            }
                                            @a.Title
                                        </div>
                                        <div class="memo-body">@a.Message</div>
                                        <div class="memo-time">@a.CreatedAtUtc.AddHours(8).ToString("MMM dd, hh:mm tt")</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="font-size:12px; color:var(--text-muted); text-align:center; padding:12px 0;">No active announcements. Click + Post to notify staff.</div>
                            }
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

