<script>
    // Live Clock
    function updateShiftTimer() {
        const timer = document.getElementById('liveShiftTimer');
        if (timer) {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            const s = String(now.getSeconds()).padStart(2, '0');
            timer.textContent = `${h}:${m}:${s}`;
        }
    }
    setInterval(updateShiftTimer, 1000);
    updateShiftTimer();

    // Live Labor Burner Ticker
    const baseLabor = @Model.TotalLaborCostSoFar;
    const ratePerSec = @Model.LiveLaborCostRatePerHour / 3600;
    let currentLabor = baseLabor;
    setInterval(() => {
        if (ratePerSec > 0) {
            currentLabor += ratePerSec;
            const el = document.getElementById('laborBurnDisplay');
            if (el) el.textContent = '₱' + currentLabor.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    }, 1000);

    // Mobile Sidebar Toggle
    const mobileBtn = document.getElementById('toggleMobileMenu');
    const sidebar = document.getElementById('sidebar');
    if (mobileBtn && sidebar) {
        mobileBtn.addEventListener('click', () => {
            sidebar.classList.toggle('open');
        });
        document.addEventListener('click', (e) => {
            if (!sidebar.contains(e.target) && !mobileBtn.contains(e.target) && sidebar.classList.contains('open')) {
                sidebar.classList.remove('open');
            }
        });
    }

    // Modal helpers
    function openModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('open');
    }
    function openAddWorkerModal() {
        openModal('addWorkerModal');
    }
    function openEditWorkerModal(id, name, payType, rate, hours) {
        document.getElementById('editWorkerId').value = id;
        document.getElementById('editFullName').value = name;
        document.getElementById('editPayType').value = payType;
        document.getElementById('editRate').value = rate;
        document.getElementById('editHoursPerDay').value = hours;
        openModal('editWorkerModal');
    }
    function openRestockModal(id, name, currentStock) {
        document.getElementById('restockProductId').value = id;
        document.getElementById('restockProductName').value = name;
        document.getElementById('restockCurrentUnits').value = currentStock + ' units';
        openModal('restockModal');
    }
    function closeModal(modalId) {
        const el = document.getElementById(modalId);
        if (el) el.classList.remove('open');
    }

    // POS helpers
    function calcSidebarSale() {
        const select = document.getElementById('sidebarPosProduct');
        if (!select) return;
        const selected = select.options[select.selectedIndex];
        const price = parseFloat(selected.getAttribute('data-price')) || 0;
        const qty = parseInt(document.getElementById('sidebarPosQty').value) || 1;
        document.getElementById('sidebarPosTotal').value = (price * qty).toFixed(2);
    }

    function autoFillPrice() {
        const select = document.getElementById('posProductSelect');
        const selected = select.options[select.selectedIndex];
        const price = parseFloat(selected.getAttribute('data-price')) || 0;
        const qty = parseInt(document.getElementById('posQuantity').value) || 1;
        document.getElementById('posTotalAmount').value = (price * qty).toFixed(2);
    }
    function calculatePosTotal() {
        autoFillPrice();
    }

    // Denomination sum
    function sumDenoms() {
        let total = 0;
        document.querySelectorAll('.denom-input').forEach(input => {
            const count = parseFloat(input.value) || 0;
            const multiplier = parseFloat(input.getAttribute('data-val')) || 1;
            total += count * multiplier;
        });
        document.getElementById('cashActualTotal').value = total.toFixed(2);
    }

    // Search filter
    function filterStaffTable() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('#staffTable tbody tr');
        rows.forEach(r => {
            const text = r.textContent.toLowerCase();
            r.style.display = text.includes(query) ? '' : 'none';
        });
    }

    function toggleMobileSidebar() {
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('sidebarBackdrop');
        if (sb) sb.classList.toggle('sidebar-open');
        if (bd) bd.classList.toggle('active');
    }

    // Live Owner Dashboard Polling
    async function fetchLiveOwnerStats() {
        try {
            const res = await fetch('/Index?handler=LiveStats');
            if (res.ok) {
                const d = await res.json();
                if (d.ok) {
                    const elClocked = document.getElementById('liveClockedInVal');
                    if (elClocked) elClocked.innerHTML = `${d.clockedInCount} <span style="font-size:14px;font-weight:400;color:var(--text-muted);">/ ${d.totalWorkers}</span>`;
                }
            }
        } catch (e) {}
    }
    setInterval(fetchLiveOwnerStats, 4000);

    // Interactive Financial Performance Chart (Chart.js)
    (function initFinanceChart() {
        const ctx = document.getElementById('ownerFinanceChart');
        if (!ctx) return;
        const c = ctx.getContext('2d');
        const grad = c.createLinearGradient(0, 0, 0, 220);
        grad.addColorStop(0, 'rgba(58, 109, 81, 0.35)');
        grad.addColorStop(1, 'rgba(58, 109, 81, 0.0)');

        const curSales = @Model.PeriodSales;
        const curCap = @Model.PeriodCapital;
        const curProfit = @Model.PeriodProfit;

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['W1', 'W2', 'W3', 'W4', 'Current (@currentRange.ToUpper())'],
                datasets: [
                    {
                        label: 'Gross Sales (₱)',
                        data: [curSales * 0.62, curSales * 0.78, curSales * 0.71, curSales * 0.89, curSales],
                        borderColor: '#234633',
                        backgroundColor: grad,
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#234633'
                    },
                    {
                        label: 'Net Profit (₱)',
                        data: [curProfit * 0.58, curProfit * 0.76, curProfit * 0.68, curProfit * 0.86, curProfit],
                        borderColor: '#137333',
                        borderWidth: 2,
                        borderDash: [5, 4],
                        fill: false,
                        tension: 0.4,
                        pointRadius: 3,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#137333'
                    },
                    {
                        label: 'Capital / Cost (₱)',
                        data: [curCap * 0.65, curCap * 0.80, curCap * 0.75, curCap * 0.91, curCap],
                        borderColor: '#8F9E95',
                        borderWidth: 1.8,
                        fill: false,
                        tension: 0.4,
                        pointRadius: 2,
                        pointHoverRadius: 5
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: true, position: 'top', labels: { boxWidth: 10, font: { size: 11, family: 'Inter' } } },
                    tooltip: {
                        backgroundColor: '#182C22',
                        titleColor: '#A9CCBA',
                        bodyColor: '#FFF',
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: (ctx) => `${ctx.dataset.label}: ₱${Number(ctx.parsed.y).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#F0F4F1' }, ticks: { font: { size: 11 }, callback: (v) => '₱' + v.toLocaleString() } },
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } }
                }
            }
        });
    })();
</script>

</body>
</html>
