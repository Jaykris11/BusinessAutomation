@page
@model ApprovalsModel
@{
    Layout = null;
    ViewData["Title"] = "Laufey | Employee Requests & Approvals";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Laufey | Employee Requests & Approvals</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

<header class="mobile-topbar">
    <div class="mobile-brand">
        <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
        <span class="brand-name">Laufey</span>
    </div>
    <button type="button" class="btn-mobile-menu" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
</header>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

<div class="app-shell">
    <aside class="app-sidebar" id="sidebar">
        <div>
            <div class="sidebar-brand">
                <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
                <span class="brand-name">Laufey</span>
            </div>

            <div class="sidebar-group-title">Main Menu</div>
            <nav class="sidebar-nav">
                <a href="/Index" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                        <span>Dashboard</span>
                    </div>
                </a>
                <a href="/Sales" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span>Sales & POS</span>
                    </div>
                </a>
                <a href="/Stocks" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        <span>Stock Management</span>
                    </div>
                </a>
                <a href="/StaffPerformance" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                        <span>Employee Performance</span>
                    </div>
                </a>
                <a href="/Approvals" class="nav-link active">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Requests & Approvals</span>
                    </div>
                </a>
                <a href="/Payslips" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9.5h20"/></svg>
                        <span>Send Payment Slips</span>
                    </div>
                </a>
            </nav>
        </div>

        <div class="sidebar-profile-card">
            <div class="profile-info">
                <div class="profile-avatar"><img src="~/images/Laufey.jpg" alt="Profile" asp-append-version="true" /></div>
                <div><div class="profile-name">Store Owner</div><div class="profile-role">Laufey Admin</div></div>
            </div>
            <a href="/Login" class="btn-signout" title="Sign out">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </a>
        </div>
    </aside>

    <main class="app-workspace">
        <header class="workspace-topbar">
            <div class="welcome-col">
                <h1>Employee Requests & Approvals</h1>
                <p>Review leave applications, PTO, VTO slot reservations, and advance payment (vale) requests</p>
            </div>
        </header>

        <div class="workspace-scroll">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="toast-alert toast-success"><span>✓ @Model.SuccessMessage</span></div>
            }

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                <!-- 1. LEAVE & PTO REQUESTS -->
                <div class="content-block">
                    <div class="block-header">
                        <div>
                            <div class="block-title">Leave / PTO / VTO Applications</div>
                            <div class="block-subtitle">Protected slot limits (Max 2 staff/day)</div>
                        </div>
                    </div>
                    @if (Model.LeaveRequests.Any())
                    {
                        @foreach (var l in Model.LeaveRequests)
                        {
                            var wName = Model.WorkerNames.TryGetValue(l.WorkerId, out var n) ? n : $"Staff #{l.WorkerId}";
                            <div style="background:#F9FBF9; border:1px solid #E1EBE4; border-radius:12px; padding:14px; margin-bottom:12px;">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <strong>@wName</strong>
                                    <span class="badge-status @(l.Status == PayrollApp.Web.Data.LeaveStatus.Approved ? "badge-present" : (l.Status == PayrollApp.Web.Data.LeaveStatus.Rejected ? "" : ""))" style="@(l.Status == PayrollApp.Web.Data.LeaveStatus.Rejected ? "background:#FCE8E6;color:#C5221F;" : (l.Status == PayrollApp.Web.Data.LeaveStatus.Pending ? "background:#FEF7E0;color:#B06000;" : ""))">
                                        @l.Status
                                    </span>
                                </div>
                                <div style="font-size:12.5px; color:var(--forest-dark); margin:6px 0;">
                                    Target Date: <strong>@l.TargetDate.ToString("MMMM dd, yyyy")</strong> &bull; Type: <strong>@l.Type</strong>
                                </div>
                                <div style="font-size:12px; color:var(--text-secondary); background:#FFF; border:1px solid #E8F0EA; border-radius:8px; padding:8px; margin-bottom:8px;">
                                    Reason: "@l.Reason"
                                </div>
                                @if (l.Status == PayrollApp.Web.Data.LeaveStatus.Pending)
                                {
                                    <div style="display:flex; gap:8px;">
                                        <form method="post" asp-page-handler="ReviewLeave" style="margin:0; flex:1;">
                                            <input type="hidden" name="leaveId" value="@l.Id" />
                                            <input type="hidden" name="status" value="1" />
                                            <button type="submit" class="btn-pill-action" style="width:100%; background:#E6F4EA; color:#137333; border-color:#CEEAD6;">✓ Approve Leave</button>
                                        </form>
                                        <form method="post" asp-page-handler="ReviewLeave" style="margin:0; flex:1;">
                                            <input type="hidden" name="leaveId" value="@l.Id" />
                                            <input type="hidden" name="status" value="2" />
                                            <button type="submit" class="btn-pill-action" style="width:100%; background:#FCE8E6; color:#C5221F; border-color:#FAD2CF;">✕ Reject</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align:center; padding:24px; color:var(--text-muted); font-size:13px;">No leave requests found.</div>
                    }
                </div>

                <!-- 2. CASH ADVANCE / VALE REQUESTS -->
                <div class="content-block">
                    <div class="block-header">
                        <div>
                            <div class="block-title">Cash Advance (Vale) Applications</div>
                            <div class="block-subtitle">Emergency funds & salary advance requests</div>
                        </div>
                    </div>
                    @if (Model.AdvanceRequests.Any())
                    {
                        @foreach (var a in Model.AdvanceRequests)
                        {
                            var wName = Model.WorkerNames.TryGetValue(a.WorkerId, out var n) ? n : $"Staff #{a.WorkerId}";
                            <div style="background:#F9FBF9; border:1px solid #E1EBE4; border-radius:12px; padding:14px; margin-bottom:12px;">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <strong>@wName</strong>
                                    <span class="badge-status @(a.Status == PayrollApp.Web.Data.AdvanceStatus.Approved ? "badge-present" : (a.Status == PayrollApp.Web.Data.AdvanceStatus.Rejected ? "" : ""))" style="@(a.Status == PayrollApp.Web.Data.AdvanceStatus.Rejected ? "background:#FCE8E6;color:#C5221F;" : (a.Status == PayrollApp.Web.Data.AdvanceStatus.Pending ? "background:#FEF7E0;color:#B06000;" : ""))">
                                        @a.Status
                                    </span>
                                </div>
                                <div style="font-size:15px; font-weight:700; color:#1E663B; margin:6px 0;">
                                    Requested: ₱@a.AmountRequested.ToString("N2")
                                </div>
                                <div style="font-size:12px; color:var(--text-secondary); background:#FFF; border:1px solid #E8F0EA; border-radius:8px; padding:8px; margin-bottom:8px;">
                                    Reason: "@a.Reason"
                                </div>
                                @if (a.Status == PayrollApp.Web.Data.AdvanceStatus.Pending)
                                {
                                    <div style="display:flex; gap:8px;">
                                        <form method="post" asp-page-handler="ReviewAdvance" style="margin:0; flex:1;">
                                            <input type="hidden" name="advanceId" value="@a.Id" />
                                            <input type="hidden" name="status" value="1" />
                                            <button type="submit" class="btn-pill-action" style="width:100%; background:#E6F4EA; color:#137333; border-color:#CEEAD6;">✓ Approve Vale</button>
                                        </form>
                                        <form method="post" asp-page-handler="ReviewAdvance" style="margin:0; flex:1;">
                                            <input type="hidden" name="advanceId" value="@a.Id" />
                                            <input type="hidden" name="status" value="2" />
                                            <button type="submit" class="btn-pill-action" style="width:100%; background:#FCE8E6; color:#C5221F; border-color:#FAD2CF;">✕ Reject</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align:center; padding:24px; color:var(--text-muted); font-size:13px;">No advance requests found.</div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>
<script>
    function toggleMobileSidebar() {
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('sidebarBackdrop');
        if (sb) sb.classList.toggle('sidebar-open');
        if (bd) bd.classList.toggle('active');
    }
</script>
</body>
</html>
