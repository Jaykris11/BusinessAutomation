@page
@model MyPayslipsModel
@{
    Layout = null;
    ViewData["Title"] = "Laufey | My Official Payment Slips";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Laufey | My Payment Slips</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

<header class="mobile-topbar">
    <div class="mobile-brand">
        <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
        <span class="brand-name">Laufey</span>
    </div>
    <div class="mobile-topbar-actions">
        <a href="/Logout" class="btn-mobile-signout" title="Sign out">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Logout</span>
        </a>
        <button type="button" class="btn-mobile-menu" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
    </div>
</header>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

<div class="app-shell">
    <aside class="app-sidebar" id="sidebar">
        <div>
            <div class="sidebar-brand">
                <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
                <span class="brand-name">Laufey</span>
            </div>

            <div class="sidebar-group-title">Staff Portal</div>
            <nav class="sidebar-nav">
                <a href="/Clock" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                        <span>My Dashboard</span>
                    </div>
                </a>
                <a href="/MyRequests" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Leaves & Vale Requests</span>
                    </div>
                </a>
                <a href="/MyPayslips" class="nav-link active">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9.5h20"/></svg>
                        <span>My Payment Slips</span>
                    </div>
                    <span class="nav-badge-pill" style="background:#E6F4EA;color:#137333;">@Model.Payslips.Count</span>
                </a>
            </nav>
        </div>

        <div class="sidebar-profile-card">
            <div class="profile-info">
                <div class="profile-avatar"><img src="~/images/Laufey.jpg" alt="Profile" asp-append-version="true" /></div>
                <div>
                    <div class="profile-name">@Model.WorkerName</div>
                    <div class="profile-role">@Model.EmployeeId &bull; Staff</div>
                </div>
            </div>
            <a href="/Logout" class="btn-signout" title="Sign out">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <main class="app-workspace">
        <header class="workspace-topbar">
            <div class="welcome-col">
                <h1>My Payment Slips (Payslips)</h1>
                <p>Official wage compensation released by owner with gross salary, vale deductions, and payment details</p>
            </div>
            <a href="/Logout" class="btn-topbar-signout" title="Sign out">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Logout</span>
            </a>
        </header>

        <div class="workspace-scroll">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="toast-alert toast-success"><span>@Model.SuccessMessage</span></div>
            }

            <div class="compact-kpi-row">
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top"><span class="kpi-mini-title">Total Payouts Received</span></div>
                    <div class="kpi-mini-val" style="color:#1E663B;">₱@Model.TotalNetEarningsReceived.ToString("N2")</div>
                    <div class="kpi-mini-sub" style="color:#137333;">@Model.Payslips.Count released slips</div>
                </div>
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top"><span class="kpi-mini-title">Hourly Wage Rate</span></div>
                    <div class="kpi-mini-val" style="color:var(--forest-dark);">₱@((Model.CurrentWorker?.HourlyRate ?? 150m).ToString("N2"))/hr</div>
                    <div class="kpi-mini-sub" style="color:var(--forest-primary);">Standard rate</div>
                </div>
            </div>

            <div class="content-block">
                <div class="block-header">
                    <div>
                        <div class="block-title">Released Payment Slips</div>
                        <div class="block-subtitle">Full breakdown of hours, gross compensation, and net pay</div>
                    </div>
                </div>

                <div style="overflow-x:auto;">
                    <table class="clean-table compact-staff-table">
                        <thead>
                            <tr>
                                <th>Pay Period</th>
                                <th>Hours Worked</th>
                                <th>Hourly Rate</th>
                                <th>Gross Pay</th>
                                <th>Vale Deductions</th>
                                <th>Other Deductions</th>
                                <th>Net Pay Out</th>
                                <th>Channel</th>
                                <th>Issued Date</th>
                                <th style="text-align:right;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payslips.Any())
                            {
                                @foreach (var ps in Model.Payslips)
                                {
                                    <tr style="cursor:pointer;" onclick="openEmpReceiptModal('@ps.Id', '@Html.Raw(Model.WorkerName.Replace("'", "\\'"))', '@Model.EmployeeId', '@Html.Raw(ps.PayPeriod.Replace("'", "\\'"))', '@ps.HoursWorked.ToString("0.00")', '@ps.HourlyRate.ToString("N2")', '@ps.GrossPay.ToString("N2")', '@ps.CashAdvanceDeductions.ToString("N2")', '@ps.OtherDeductions.ToString("N2")', '@ps.NetPay.ToString("N2")', '@ps.PaymentMethod', '@ps.IssuedAtUtc.AddHours(8).ToString("MMM dd, yyyy")', '@(ps.IsAcknowledged ? "✓ Received & Signed" : "Pending Receipt")', '@Html.Raw((ps.Remarks ?? "Standard payroll payout").Replace("'", "\\'"))')">
                                        <td><strong>@ps.PayPeriod</strong></td>
                                        <td>@ps.HoursWorked.ToString("0.00") hrs</td>
                                        <td>₱@ps.HourlyRate.ToString("N2")/hr</td>
                                        <td>₱@ps.GrossPay.ToString("N2")</td>
                                        <td style="color:#C5221F;">-₱@ps.CashAdvanceDeductions.ToString("N2")</td>
                                        <td style="color:#C5221F;">-₱@ps.OtherDeductions.ToString("N2")</td>
                                        <td><strong style="color:#137333; font-size:15px;">₱@ps.NetPay.ToString("N2")</strong></td>
                                        <td><span class="badge-status" style="background:#F0F5F1; color:var(--forest-dark);">@ps.PaymentMethod</span></td>
                                        <td>@ps.IssuedAtUtc.AddHours(8).ToString("MMM dd, yyyy")</td>
                                        <td style="text-align:right; white-space:nowrap;" onclick="event.stopPropagation();">
                                            <button type="button" class="btn-pill-action" style="margin-right:4px;" onclick="openEmpReceiptModal('@ps.Id', '@Html.Raw(Model.WorkerName.Replace("'", "\\'"))', '@Model.EmployeeId', '@Html.Raw(ps.PayPeriod.Replace("'", "\\'"))', '@ps.HoursWorked.ToString("0.00")', '@ps.HourlyRate.ToString("N2")', '@ps.GrossPay.ToString("N2")', '@ps.CashAdvanceDeductions.ToString("N2")', '@ps.OtherDeductions.ToString("N2")', '@ps.NetPay.ToString("N2")', '@ps.PaymentMethod', '@ps.IssuedAtUtc.AddHours(8).ToString("MMM dd, yyyy")', '@(ps.IsAcknowledged ? "✓ Received & Signed" : "Pending Receipt")', '@Html.Raw((ps.Remarks ?? "Standard payroll payout").Replace("'", "\\'"))')">View Receipt</button>
                                            @if (ps.IsAcknowledged)
                                            {
                                                <span class="badge-status badge-present">✓ Received</span>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="Acknowledge" style="margin:0; display:inline;">
                                                    <input type="hidden" name="payslipId" value="@ps.Id" />
                                                    <button type="submit" class="btn-pill-action">Confirm Receipt</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="10" style="text-align:center; padding:24px; color:var(--text-muted);">No payment slips released yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- OFFICIAL SALARY RECEIPT / VOUCHER MODAL -->
<div id="receiptModal" class="modal-backdrop" style="display:none; position:fixed; inset:0; background:rgba(18,34,26,0.65); backdrop-filter:blur(4px); z-index:99999; align-items:center; justify-content:center; padding:16px;">
    <div class="receipt-card" style="background:#FFF; max-width:520px; width:100%; border-radius:18px; overflow:hidden; box-shadow:0 24px 48px rgba(0,0,0,0.25); border:1px solid #E0EBE3;">
        <div style="background:linear-gradient(135deg, #182C22 0%, #294F3B 100%); color:#FFF; padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:36px; height:36px; border-radius:50%; overflow:hidden; border:2px solid #5EEA99; background:#FFF;">
                    <img src="/images/Laufey.jpg" alt="Laufey" style="width:100%; height:100%; object-fit:cover;" />
                </div>
                <div>
                    <h3 style="margin:0; font-size:16px; font-weight:700;">Laufey Store</h3>
                    <div style="font-size:11px; color:#A9CCBA; text-transform:uppercase; letter-spacing:0.8px;">Official Compensation Voucher</div>
                </div>
            </div>
            <button type="button" onclick="closeEmpReceiptModal()" style="background:none; border:none; color:#FFF; font-size:20px; cursor:pointer;">✕</button>
        </div>
        <div id="receiptPrintArea" style="padding:22px 24px; font-size:13px; color:#142019;">
            <div style="display:flex; justify-content:space-between; padding-bottom:12px; border-bottom:1px dashed #D5E2D9; margin-bottom:14px;">
                <div>
                    <span style="font-size:11px; color:#6B8074;">VOUCHER NO.</span>
                    <div id="rcptVoucherNo" style="font-weight:700; font-size:14px; font-family:monospace;">#LP-2026-0001</div>
                </div>
                <div style="text-align:right;">
                    <span style="font-size:11px; color:#6B8074;">ISSUED ON</span>
                    <div id="rcptIssuedDate" style="font-weight:600;">Nov 25, 2026</div>
                </div>
            </div>
            <div style="background:#F6FAF7; border:1px solid #DCE8E0; border-radius:10px; padding:12px 14px; margin-bottom:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span style="color:#63756A;">Personnel:</span><strong id="rcptWorkerName"></strong></div>
                <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span style="color:#63756A;">Staff ID:</span><strong id="rcptEmpId" style="font-family:monospace;"></strong></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#63756A;">Pay Period:</span><strong id="rcptPayPeriod" style="color:#234633;"></strong></div>
            </div>
            <div style="margin-bottom:14px;">
                <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:#4B6354; margin-bottom:6px;">Earnings Breakdown</div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0;"><span>Hours Rendered</span><span id="rcptHoursWorked" style="font-weight:600;"></span></div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0;"><span>Hourly Rate</span><span id="rcptHourlyRate" style="font-weight:600;"></span></div>
                <div style="display:flex; justify-content:space-between; padding:7px 0; font-weight:700; border-bottom:1.5px solid #D5E2D9;"><span>Gross Earnings</span><span id="rcptGrossPay" style="color:#1E663B;"></span></div>
            </div>
            <div style="margin-bottom:16px;">
                <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:#853B3B; margin-bottom:6px;">Deductions</div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0; color:#A82222;"><span>Cash Advance / Vale</span><span id="rcptValeDeductions"></span></div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #EEF4F0; color:#A82222;"><span>Other Deductions</span><span id="rcptOtherDeductions"></span></div>
            </div>
            <div style="background:linear-gradient(135deg, #182C22 0%, #224231 100%); color:#FFF; border-radius:10px; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div>
                    <div style="font-size:10.5px; text-transform:uppercase; color:#A9CCBA;">Total Net Payout</div>
                    <div style="font-size:12px;">Via <strong id="rcptPaymentMethod"></strong></div>
                </div>
                <div id="rcptNetPay" style="font-size:24px; font-weight:800; color:#5EEA99;"></div>
            </div>
            <div style="font-size:11.5px; color:#6B8074; margin-bottom:10px;">Remarks: <span id="rcptRemarks"></span></div>
            <div style="display:flex; justify-content:space-between; padding-top:10px; font-size:11.5px; color:#6B8074; border-top:1px dashed #D5E2D9;">
                <div>Issued by: <strong>Laufey Management</strong></div>
                <div>Status: <strong id="rcptAckStatus" style="color:#137333;"></strong></div>
            </div>
        </div>
        <div style="background:#F7FAF8; border-top:1px solid #E3ECE6; padding:12px 24px; display:flex; justify-content:space-between;">
            <button type="button" onclick="closeEmpReceiptModal()" style="background:#FFF; border:1px solid #CFDDD4; border-radius:8px; padding:8px 16px; font-size:12.5px; font-weight:600; cursor:pointer;">Close</button>
            <button type="button" onclick="window.print()" style="background:#234633; border:none; border-radius:8px; padding:8px 18px; font-size:12.5px; font-weight:600; color:#FFF; cursor:pointer;">Print / Save PDF</button>
        </div>
    </div>
</div>

<script>
    function toggleMobileSidebar() {
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('sidebarBackdrop');
        if (sb) sb.classList.toggle('sidebar-open');
        if (bd) bd.classList.toggle('active');
    }

    function openEmpReceiptModal(id, workerName, empId, payPeriod, hours, rate, gross, vale, other, net, method, issuedDate, ackStatus, remarks) {
        document.getElementById('rcptVoucherNo').textContent = '#LP-' + new Date().getFullYear() + '-' + String(id).padStart(4, '0');
        document.getElementById('rcptIssuedDate').textContent = issuedDate;
        document.getElementById('rcptWorkerName').textContent = workerName;
        document.getElementById('rcptEmpId').textContent = empId;
        document.getElementById('rcptPayPeriod').textContent = payPeriod;
        document.getElementById('rcptHoursWorked').textContent = hours + ' hrs';
        document.getElementById('rcptHourlyRate').textContent = '₱' + rate + ' / hr';
        document.getElementById('rcptGrossPay').textContent = '₱' + gross;
        document.getElementById('rcptValeDeductions').textContent = '-₱' + vale;
        document.getElementById('rcptOtherDeductions').textContent = '-₱' + other;
        document.getElementById('rcptNetPay').textContent = '₱' + net;
        document.getElementById('rcptPaymentMethod').textContent = method;
        document.getElementById('rcptAckStatus').textContent = ackStatus;
        document.getElementById('rcptRemarks').textContent = remarks;
        document.getElementById('receiptModal').style.display = 'flex';
    }
    function closeEmpReceiptModal() {
        document.getElementById('receiptModal').style.display = 'none';
    }
</script>
</body>
</html>
