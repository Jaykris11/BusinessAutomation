@page
@model StaffPerformanceModel
@{
    Layout = null;
    ViewData["Title"] = "Laufey | Staff Performance Leaderboard";
    var currentRange = Model.Range?.ToLower() ?? "monthly";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Laufey | Staff Performance Leaderboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .rank-badge {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
        }
        .rank-1 { background: #FEF7E0; color: #B06000; border: 1.5px solid #F9AB00; }
        .rank-2 { background: #F1F3F4; color: #5F6368; border: 1.5px solid #BDC1C6; }
        .rank-3 { background: #FCE8E6; color: #C5221F; border: 1.5px solid #F28B82; }
        .rank-other { background: #F8FAF9; color: var(--text-muted); }
    </style>
</head>
<body class="dashboard-body">

<header class="mobile-topbar">
    <div class="mobile-brand">
        <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
        <span class="brand-name">Laufey</span>
    </div>
    <button type="button" class="btn-mobile-menu" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
</header>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

<div class="app-shell">
    <aside class="app-sidebar" id="sidebar">
        <div>
            <div class="sidebar-brand">
                <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
                <span class="brand-name">Laufey</span>
            </div>

            <div class="sidebar-group-title">Main Menu</div>
            <nav class="sidebar-nav">
                <a href="/Index" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                        <span>Dashboard</span>
                    </div>
                </a>
                <a href="/Sales" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span>Sales & POS</span>
                    </div>
                </a>
                <a href="/Stocks" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        <span>Stock Management</span>
                    </div>
                </a>
                <a href="/StaffPerformance" class="nav-link active">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                        <span>Employee Performance</span>
                    </div>
                </a>
                <a href="/Approvals" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Requests & Approvals</span>
                    </div>
                </a>
                <a href="/Payslips" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9.5h20"/></svg>
                        <span>Send Payment Slips</span>
                    </div>
                </a>
                <a href="/StaffAccounts" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        <span>Staff Accounts</span>
                    </div>
                </a>
            </nav>
        </div>

        <div class="sidebar-profile-card">
            <div class="profile-info">
                <div class="profile-avatar"><img src="~/images/Laufey.jpg" alt="Profile" asp-append-version="true" /></div>
                <div><div class="profile-name">Store Owner</div><div class="profile-role">Laufey Admin</div></div>
            </div>
            <a href="/Login" class="btn-signout" title="Sign out">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </a>
        </div>
    </aside>

    <main class="app-workspace">
        <header class="workspace-topbar">
            <div class="welcome-col">
                <h1>Employee Performance & Leaderboard</h1>
                <p>Accumulated shift hours, total gross earnings, and top attendance rankings</p>
            </div>

            <div style="display:flex; align-items:center; gap:6px; background:#F0F5F1; padding:3px 6px; border-radius:var(--radius-pill); border:1px solid var(--border-subtle);">
                <a href="?range=daily" class="btn-filter-pill @(currentRange == "daily" ? "active-range" : "")">Daily</a>
                <a href="?range=weekly" class="btn-filter-pill @(currentRange == "weekly" ? "active-range" : "")">Weekly</a>
                <a href="?range=monthly" class="btn-filter-pill @(currentRange == "monthly" ? "active-range" : "")">Monthly</a>
                <a href="?range=yearly" class="btn-filter-pill @(currentRange == "yearly" ? "active-range" : "")">Yearly</a>
            </div>
        </header>

        <div class="workspace-scroll">
            <div class="compact-kpi-row">
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top">
                        <span class="kpi-mini-title">Total Staff Hours</span>
                        <div class="pulse-badge" style="padding:1px 6px; font-size:9.5px;"><i class="pulse-dot"></i> Live</div>
                    </div>
                    <div class="kpi-mini-val" id="displayTotalHours">@Model.TotalTeamHours.ToString("0.00") <span style="font-size:13px;font-weight:400;color:var(--text-muted);">hrs</span></div>
                    <div class="kpi-mini-sub" style="color:var(--forest-primary);">Across all active staff</div>
                </div>
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top">
                        <span class="kpi-mini-title">Total Wages Accumulated</span>
                        <div class="pulse-badge" style="padding:1px 6px; font-size:9.5px;"><i class="pulse-dot"></i> Live</div>
                    </div>
                    <div class="kpi-mini-val" id="displayTotalWages" style="color:#1E663B;">₱@Model.TotalPayrollWages.ToString("N2")</div>
                    <div class="kpi-mini-sub" style="color:#137333;">Gross payroll payout</div>
                </div>
                <div class="kpi-mini-card" style="background:linear-gradient(145deg, #182C22 0%, #294F3B 100%); color:#FFF;">
                    <div class="kpi-mini-top"><span class="kpi-mini-title" style="color:#A9CCBA;">🏆 Top Performer</span></div>
                    <div class="kpi-mini-val" id="displayTopPerformer" style="color:#FFF; font-size:20px;">@Model.TopPerformerName</div>
                    <div class="kpi-mini-sub" style="color:rgba(255,255,255,0.8);">Rank #1 in logged hours</div>
                </div>
            </div>

            <div class="content-block" style="margin-bottom:20px;">
                <div class="block-header" style="margin-bottom:10px;">
                    <div>
                        <div class="block-title">Staff Hours & Earnings Distribution (@currentRange.ToUpper())</div>
                        <div class="block-subtitle">Hover or tap bars to inspect individual employee output in real time</div>
                    </div>
                </div>
                <div style="position:relative; height:220px; width:100%;">
                    <canvas id="staffChart"></canvas>
                </div>
            </div>

            <div class="content-block">
                <div class="block-header">
                    <div>
                        <div class="block-title">Staff Attendance & Earnings Leaderboard (@currentRange.ToUpper())</div>
                        <div class="block-subtitle">Live auto-updating ranking with real-time earnings & hours</div>
                    </div>
                    <div style="font-size:11.5px; color:var(--text-secondary); display:flex; align-items:center; gap:6px;">
                        <span class="pulse-badge" style="padding:1px 6px; font-size:9.5px;"><i class="pulse-dot"></i> Live Sync</span>
                    </div>
                </div>

                <div style="overflow-x:auto;">
                    <table class="clean-table compact-staff-table" id="leaderboardTable">
                        <thead>
                            <tr>
                                <th style="width:50px;">Rank</th>
                                <th>Staff Member</th>
                                <th>Pay Type & Rate</th>
                                <th>Total Hours Logged</th>
                                <th>Accumulated Earnings</th>
                                <th>Shifts Completed</th>
                            </tr>
                        </thead>
                        <tbody id="leaderboardBody">
                            @foreach (var row in Model.Leaderboard)
                            {
                                <tr>
                                    <td>
                                        <span class="rank-badge @(row.Rank == 1 ? "rank-1" : (row.Rank == 2 ? "rank-2" : (row.Rank == 3 ? "rank-3" : "rank-other")))">
                                            @row.Rank
                                        </span>
                                    </td>
                                    <td>
                                        <div class="table-user-cell">
                                            <div class="table-user-avatar"><img src="~/images/Laufey.jpg" alt="" asp-append-version="true" /></div>
                                            <div>
                                                <div class="table-user-name">@row.FullName</div>
                                                <div class="table-user-id">@row.EmployeeId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>₱@row.Rate.ToString("N2") @(row.PayType == PayrollApp.Web.Data.PayType.Hourly ? "/hr" : "/day")</td>
                                    <td><strong style="color:var(--forest-dark); font-size:14px;">@row.HoursWorked.ToString("0.00")</strong> hrs</td>
                                    <td><strong style="color:#1E663B; font-size:14px;">₱@row.EarnedAmount.ToString("N2")</strong></td>
                                    <td>@row.ShiftsCompleted shifts</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    const currentRange = '@currentRange';
    let staffPerfChart = null;

    function renderStaffChart(rows) {
        const ctx = document.getElementById('staffChart');
        if (!ctx) return;

        const labels = rows.map(r => r.fullName || r.FullName);
        const earnings = rows.map(r => r.earnedAmount ?? r.EarnedAmount ?? 0);
        const hours = rows.map(r => r.hoursWorked ?? r.HoursWorked ?? 0);

        if (staffPerfChart) {
            staffPerfChart.data.labels = labels;
            staffPerfChart.data.datasets[0].data = earnings;
            staffPerfChart.data.datasets[1].data = hours;
            staffPerfChart.update('none');
            return;
        }

        staffPerfChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    {
                        label: 'Accumulated Earnings (₱)',
                        data: earnings,
                        backgroundColor: 'rgba(35, 70, 51, 0.85)',
                        borderRadius: 6,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Hours Logged',
                        data: hours,
                        backgroundColor: 'rgba(94, 234, 153, 0.8)',
                        borderRadius: 6,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: true, position: 'top', labels: { boxWidth: 10, font: { size: 11 } } },
                    tooltip: {
                        backgroundColor: '#182C22',
                        titleColor: '#A9CCBA',
                        bodyColor: '#FFF',
                        padding: 10,
                        cornerRadius: 8
                    }
                },
                scales: {
                    y: { type: 'linear', position: 'left', beginAtZero: true, grid: { color: '#F0F4F1' }, ticks: { font: { size: 11 }, callback: (v) => '₱' + v.toLocaleString() } },
                    y1: { type: 'linear', position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, ticks: { font: { size: 11 }, callback: (v) => v + 'h' } },
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } }
                }
            }
        });
    }

    // Initial render
    const initialRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Leaderboard));
    renderStaffChart(initialRows);

    async function pollPerformance() {
        try {
            const resp = await fetch(`/StaffPerformance?handler=Data&range=${currentRange}`);
            if (!resp.ok) return;
            const data = await resp.json();

            // Update top KPIs
            document.getElementById('displayTotalHours').innerHTML = `${data.totalTeamHours.toFixed(2)} <span style="font-size:13px;font-weight:400;color:var(--text-muted);">hrs</span>`;
            document.getElementById('displayTotalWages').textContent = `₱${data.totalPayrollWages.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            document.getElementById('displayTopPerformer').textContent = data.topPerformerName;

            if (data.leaderboard && data.leaderboard.length > 0) {
                renderStaffChart(data.leaderboard);
            }

            // Rebuild leaderboard rows
            const tbody = document.getElementById('leaderboardBody');
            if (tbody && data.leaderboard && data.leaderboard.length > 0) {
                tbody.innerHTML = data.leaderboard.map(row => {
                    const rankClass = row.rank === 1 ? 'rank-1' : (row.rank === 2 ? 'rank-2' : (row.rank === 3 ? 'rank-3' : 'rank-other'));
                    const paySuffix = row.payType === 0 ? '/hr' : '/day';
                    return `
                        <tr>
                            <td><span class="rank-badge ${rankClass}">${row.rank}</span></td>
                            <td>
                                <div class="table-user-cell">
                                    <div class="table-user-avatar"><img src="/images/Laufey.jpg" alt="" /></div>
                                    <div>
                                        <div class="table-user-name">${row.fullName}</div>
                                        <div class="table-user-id">${row.employeeId}</div>
                                    </div>
                                </div>
                            </td>
                            <td>₱${row.rate.toFixed(2)} ${paySuffix}</td>
                            <td><strong style="color:var(--forest-dark); font-size:14px;">${row.hoursWorked.toFixed(2)}</strong> hrs</td>
                            <td><strong style="color:#1E663B; font-size:14px;">₱${row.earnedAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
                            <td>${row.shiftsCompleted} shifts</td>
                        </tr>
                    `;
                }).join('');
            }
        } catch (e) {
            console.error('Real-time sync error', e);
        }
    }

    // Auto-poll every 3 seconds for seamless real-time viewing without page refreshes
    setInterval(pollPerformance, 3000);
</script>
<script>
    function toggleMobileSidebar() {
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('sidebarBackdrop');
        if (sb) sb.classList.toggle('sidebar-open');
        if (bd) bd.classList.toggle('active');
    }
</script>
</body>
</html>
