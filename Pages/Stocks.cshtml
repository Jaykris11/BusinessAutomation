@page
@model StocksModel
@{
    Layout = null;
    ViewData["Title"] = "Laufey | Stock Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Laufey | Stock Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

<header class="mobile-topbar">
    <div class="mobile-brand">
        <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
        <span class="brand-name">Laufey</span>
    </div>
    <div class="mobile-topbar-actions">
        <a href="/Logout" class="btn-mobile-signout" title="Sign out">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Logout</span>
        </a>
        <button type="button" class="btn-mobile-menu" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
    </div>
</header>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

<div class="app-shell">
    <aside class="app-sidebar" id="sidebar">
        <div>
            <div class="sidebar-brand">
                <div class="brand-circle"><img src="~/images/Laufey.jpg" alt="Laufey Logo" asp-append-version="true" /></div>
                <span class="brand-name">Laufey</span>
            </div>

            <div class="sidebar-group-title">Main Menu</div>
            <nav class="sidebar-nav">
                <a href="/Index" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                        <span>Dashboard</span>
                    </div>
                </a>
                <a href="/Sales" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span>Sales & POS</span>
                    </div>
                </a>
                <a href="/Stocks" class="nav-link active">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        <span>Stock Management</span>
                    </div>
                    @if (Model.LowStockCount > 0)
                    {
                        <span class="nav-badge-pill" style="background:#FCE8E6;color:#C5221F;">@Model.LowStockCount</span>
                    }
                </a>
                <a href="/StaffPerformance" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                        <span>Employee Performance</span>
                    </div>
                </a>
                <a href="/Approvals" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Requests & Approvals</span>
                    </div>
                </a>
                <a href="/Payslips" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9.5h20"/></svg>
                        <span>Send Payment Slips</span>
                    </div>
                </a>
                <a href="/StaffAccounts" class="nav-link">
                    <div class="nav-link-left">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        <span>Staff Accounts</span>
                    </div>
                </a>
            </nav>
        </div>

        <div class="sidebar-profile-card">
            <div class="profile-info">
                <div class="profile-avatar"><img src="~/images/Laufey.jpg" alt="Profile" asp-append-version="true" /></div>
                <div><div class="profile-name">Store Owner</div><div class="profile-role">Laufey Admin</div></div>
            </div>
            <a href="/Logout" class="btn-signout" title="Sign out">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <main class="app-workspace">
        <header class="workspace-topbar">
            <div class="welcome-col">
                <h1>Stock & Inventory Catalog</h1>
                <p>Manage product items, dedicated cost and selling prices, restock quantities, and low stock thresholds</p>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <button type="button" class="btn-action-primary" onclick="openStockModal('addStockModal')">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span>+ Add Stock Item</span>
                </button>
                <a href="/Logout" class="btn-topbar-signout" title="Sign out">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Logout</span>
                </a>
            </div>
        </header>

        <div class="workspace-scroll">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="toast-alert toast-success"><span>✓ @Model.SuccessMessage</span></div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="toast-alert" style="background:#FCE8E6;color:#C5221F;"><span>⚠️ @Model.ErrorMessage</span></div>
            }

            <div class="compact-kpi-row">
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top"><span class="kpi-mini-title">Total Inventory Units</span></div>
                    <div class="kpi-mini-val">@Model.TotalUnitsInStock <span style="font-size:13px;font-weight:400;color:var(--text-muted);">units</span></div>
                    <div class="kpi-mini-sub" style="color:var(--forest-primary);">@Model.Products.Count unique items</div>
                </div>
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top"><span class="kpi-mini-title">Reorder Alerts</span></div>
                    <div class="kpi-mini-val" style="color:@(Model.LowStockCount > 0 ? "#C5221F" : "#137333");">@Model.LowStockCount</div>
                    <div class="kpi-mini-sub" style="color:@(Model.LowStockCount > 0 ? "#C5221F" : "#137333");">@(Model.LowStockCount > 0 ? "⚠️ Needs urgent replenishment" : "✓ Stock healthy")</div>
                </div>
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top"><span class="kpi-mini-title">Inventory Capital Value</span></div>
                    <div class="kpi-mini-val" style="color:#6A7D73;">₱@Model.TotalInventoryCostValuation.ToString("N2")</div>
                    <div class="kpi-mini-sub" style="color:var(--text-muted);">Total purchase cost</div>
                </div>
                <div class="kpi-mini-card">
                    <div class="kpi-mini-top"><span class="kpi-mini-title">Potential Retail Value</span></div>
                    <div class="kpi-mini-val" style="color:#137333;">₱@Model.TotalInventoryRetailValuation.ToString("N2")</div>
                    <div class="kpi-mini-sub" style="color:#137333;">Estimated sales yield</div>
                </div>
            </div>

            <div class="content-block">
                <div class="block-header">
                    <div>
                        <div class="block-title">Active Inventory & Stock Details</div>
                        <div class="block-subtitle">Live units on hand, unit cost, selling price, and reorder alerts</div>
                    </div>
                </div>
                <div style="overflow-x:auto;">
                    <table class="clean-table compact-staff-table">
                        <thead>
                            <tr>
                                <th>Item / Stock Name</th>
                                <th>Category</th>
                                <th>Cost (Capital)</th>
                                <th>Selling Price (SRP)</th>
                                <th>Profit Margin</th>
                                <th>Units On Shelf</th>
                                <th>Status</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Products)
                            {
                                var margin = p.Price > 0 ? Math.Round(((p.Price - p.Cost) / p.Price) * 100, 1) : 0;
                                <tr>
                                    <td><strong>@p.Name</strong></td>
                                    <td><span style="font-size:11.5px; background:#F0F5F1; padding:2px 8px; border-radius:4px;">@p.Category</span></td>
                                    <td style="color:#6A7D73;">₱@p.Cost.ToString("N2")</td>
                                    <td><strong style="color:var(--forest-dark);">₱@p.Price.ToString("N2")</strong></td>
                                    <td><span style="color:#137333; font-weight:600;">+@margin%</span></td>
                                    <td><strong>@p.CurrentStock</strong> <span style="font-size:11px; color:var(--text-muted);">(Limit: @p.LowStockAlert)</span></td>
                                    <td>
                                        @if (p.IsLowStock)
                                        {
                                            <span class="badge-status" style="background:#FCE8E6;color:#C5221F;">⚠️ Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-present">✓ In Stock</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <button type="button" class="btn-pill-action" onclick="openRestockModal(@p.Id, '@p.Name', @p.CurrentStock)">+ Restock</button>
                                        <form method="post" asp-page-handler="DeleteProduct" style="display:inline; margin-left:4px;" onsubmit="return confirm('Remove @p.Name from catalog?');">
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <button type="submit" class="btn-pill-action" style="color:#C0392B;">✕</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- MODAL: ADD STOCK ITEM -->
<div class="modal-overlay" id="addStockModal">
    <div class="modal-box">
        <form method="post" asp-page-handler="AddProduct">
            <div class="modal-head">
                <h3>Add New Stock Item</h3>
                <button type="button" class="modal-close-btn" onclick="closeStockModal('addStockModal')">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Product / Item Name</label>
                    <input type="text" name="name" placeholder="e.g. Milktea (Wintermelon)" required />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <input type="text" name="category" placeholder="e.g. Beverages, Ingredients, Packaging" value="Beverages" />
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Cost Price (Capital ₱)</label>
                        <input type="number" step="0.01" name="cost" placeholder="45.00" value="45.00" required />
                    </div>
                    <div class="form-group">
                        <label>Selling Price (SRP ₱)</label>
                        <input type="number" step="0.01" name="price" placeholder="95.00" value="95.00" required />
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Initial Stock Units</label>
                        <input type="number" name="initialStock" value="20" min="0" required />
                    </div>
                    <div class="form-group">
                        <label>Low Stock Alert Threshold</label>
                        <input type="number" name="alertThreshold" value="5" min="1" required />
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn-secondary" onclick="closeStockModal('addStockModal')">Cancel</button>
                <button type="submit" class="btn-primary">Add Product Stock</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: RESTOCK -->
<div class="modal-overlay" id="restockModal">
    <div class="modal-box">
        <form method="post" asp-page-handler="Restock">
            <input type="hidden" name="productId" id="restockProdId" />
            <div class="modal-head">
                <h3>Restock Inventory</h3>
                <button type="button" class="modal-close-btn" onclick="closeStockModal('restockModal')">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Item Name</label>
                    <input type="text" id="restockProdName" readonly style="background:#F4F7F4;" />
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Current Stock</label>
                        <input type="text" id="restockCurrentUnits" readonly style="background:#F4F7F4;" />
                    </div>
                    <div class="form-group">
                        <label>Add Units (+)</label>
                        <input type="number" name="addUnits" value="10" min="1" required />
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn-secondary" onclick="closeStockModal('restockModal')">Cancel</button>
                <button type="submit" class="btn-primary">Confirm Restock</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openStockModal(id) { document.getElementById(id).classList.add('open'); }
    function closeStockModal(id) { document.getElementById(id).classList.remove('open'); }
    function openRestockModal(id, name, cur) {
        document.getElementById('restockProdId').value = id;
        document.getElementById('restockProdName').value = name;
        document.getElementById('restockCurrentUnits').value = cur + ' units';
        openStockModal('restockModal');
    }
</script>
<script>
    function toggleMobileSidebar() {
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('sidebarBackdrop');
        if (sb) sb.classList.toggle('sidebar-open');
        if (bd) bd.classList.toggle('active');
    }
</script>
</body>
</html>
